// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  privyUserId  String?  @unique // Privy user ID for syncing
  walletAddress String? // Embedded wallet address from Privy
  createdAt    DateTime @default(now())

  memberships Membership[]
  vouchesGiven Vouch[] @relation("VouchesGiven")
  vouchesReceived Vouch[] @relation("VouchesReceived")
  messages Message[]
  moments Moment[]
  momentComments MomentComment[]
  joinRequests JoinRequest[]
  
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Community {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  coverImage           String?  // path to uploaded cover image
  isDiscoverable       Boolean  @default(false) // controls visibility on Discover page
  requiresFinalApproval Boolean @default(false) // if true, creator/validator must approve after vouches
  requiredVouches      Int      // 1 | 2 | 3
  memberCooldownDays   Int      // 7 | 30
  createdAt            DateTime @default(now())

  memberships Membership[]
  vouches Vouch[]
  messages Message[]
  moments Moment[]
  joinRequests JoinRequest[]
}

model Membership {
  id                String   @id @default(cuid())
  userId            String
  communityId       String
  role              Role
  joinedAt          DateTime @default(now())

  lastVouchAt       DateTime?
  cooldownPenalty   Boolean  @default(false)

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
}

enum Role {
  FOUNDER
  VALIDATOR
  MEMBER
}

model Vouch {
  id           String   @id @default(cuid())
  fromUserId   String
  toUserId     String
  communityId  String
  createdAt    DateTime @default(now())

  fromUser User @relation("VouchesGiven", fields: [fromUserId], references: [id])
  toUser   User @relation("VouchesReceived", fields: [toUserId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([fromUserId, toUserId, communityId])
}

model Message {
  id           String   @id @default(cuid())
  communityId  String
  userId       String
  content      String
  createdAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])
}

model Moment {
  id           String   @id @default(cuid())
  communityId  String
  userId       String
  content      String
  image        String?  // path to uploaded image
  createdAt    DateTime @default(now())

  comments MomentComment[]

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

enum JoinRequestStatus {
  PENDING_VOUCHES  // waiting for vouches
  PENDING_APPROVAL // has enough vouches, waiting for creator/validator approval
  REJECTED         // rejected by creator/validator
}

model JoinRequest {
  id           String            @id @default(cuid())
  communityId  String
  userId       String
  status       JoinRequestStatus @default(PENDING_VOUCHES)
  createdAt    DateTime          @default(now())

  community Community @relation(fields: [communityId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
}

